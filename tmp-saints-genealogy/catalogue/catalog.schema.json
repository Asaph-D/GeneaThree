{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geneatreepro.app/schemas/discovery-catalog-v1.json",
  "title": "Catalogue Découvrir GeneaTreePro",
  "type": "object",
  "required": ["version", "categories", "entries"],
  "properties": {
    "version": { "const": 1 },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "category", "title", "description", "aliases", "status", "metadata"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["saint", "biblical-genealogy"] },
          "category": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "status": {
            "type": "object",
            "required": ["research", "genealogy", "images"]
          },
          "metadata": { "type": "string" }
        }
      }
    }
  }
}
