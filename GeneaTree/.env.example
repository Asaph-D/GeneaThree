# true  : service local, sans backend (valeur sûre par défaut)
# false : synchronisation Spring uniquement avec authentification configurée
VITE_USE_LOCAL_FAMILY_SERVICE=true

# URL locale de base de l'API. En production, le repli intégré est
# https://geneathree.onrender.com/api
VITE_API_BASE_URL=http://localhost:8086/api

# Authentification et synchronisation de profil (Supabase Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
# La clé générée par l'intégration Vercel/Supabase est aussi acceptée :
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ne jamais exposer au frontend : SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, POSTGRES_PASSWORD et les URL PostgreSQL contenant un mot de passe.
